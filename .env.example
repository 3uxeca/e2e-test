# 환경 (local | staging | prod). 1주차는 local 고정.
ENV=local

# 대상 웹앱
TARGET_URL=http://localhost:3000
LOGIN_URL=http://localhost:3000/auth/login

# 테스트 계정 (슈퍼 계정: ROLE_SYSTEM_ADMIN)
TEST_EMAIL=facility@airport.co.kr
TEST_PASSWORD=

# Anthropic
# Max/Pro plan 사용자는 비워둬도 된다. Claude Code CLI(`claude`) OAuth 자격증명을 자동 사용한다.
# Console 결제(API key) 사용자만 발급받은 키를 채워라.
ANTHROPIC_API_KEY=

# 모델/토큰 상한은 단계별로 src/stages/config.ts 에서 관리한다 (1주차 모두 Opus 4.7 단일).

# ───── 시드 데이터 가정 (선택) ─────
# 미설정 시 1주차 baseline 값이 쓰인다. 시드 환경이 다르면
# docs/seed-assumptions.md 를 참고하여 채워라.

# /management/logs (시스템 로그) 시드
SEED_LOG_COUNT=
SEED_LOG_KEYWORD=

# /dashboard/replay 가 실제 좌표 데이터를 가지고 있는 날짜·시간 범위.
# 아무 날짜에나 데이터가 있는 게 아니라 좌표가 적재된 범위만 의미 있다.
# 미설정 시 stage1·stage3 가 임의 날짜를 시도해 빈 데이터를 보고 후보를
# 약하게 평가하거나 테스트가 깨질 수 있다.
SEED_REPLAY_DATE=
SEED_REPLAY_START_TIME=
SEED_REPLAY_END_TIME=
